  "type": "kimai-plugin",
  "version": "0.1.1",
  "require": {
    "php": ">=8.2",
    "kimai/kimai": ">=2.60.0"
  },
  "keywords": [
    "kimai",
    "kimai-plugin",
    "planner",
    "forecast",
    "harvest",
    "migration"
  ],
  "license": "AGPL-3.0-or-later",
  "authors": [
    {
      "name": "Angry Creative",
      "homepage": "https://angrycreative.se"
    }
  ],
  "extra": {
    "kimai": {
      "require": 26000,
      "name": "ForecastImport",
      "version": "0.1.1"
    }
  }
}
