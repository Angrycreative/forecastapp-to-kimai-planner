{% extends '@ForecastImport/_layout.html.twig' %}

{% block heading %}{{ 'forecast_import.step_people'|trans }}{% endblock %}
{% block heading_actions %}
    <a href="{{ path('forecast_import_projects') }}" class="btn btn-primary">{{ 'forecast_import.next_projects'|trans }}</a>
{% endblock %}

{% block content %}
    <p class="text-secondary" style="max-width: 70ch">{{ 'forecast_import.people_intro'|trans }}</p>
    <div class="card">
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th>{{ 'forecast_import.col_person'|trans }}</th>
                        <th>{{ 'forecast_import.col_planned'|trans }}</th>
                        <th>{{ 'forecast_import.col_goes_to'|trans }}</th>
                        <th>{{ 'forecast_import.status'|trans }}</th>
                        <th class="w-1"><span class="visually-hidden">{{ 'forecast_import.change'|trans }}</span></th>
                    </tr>
                </thead>
                <tbody>
                    {% for row in rows %}
                        {{ include('@ForecastImport/_person_row.html.twig') }}
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
