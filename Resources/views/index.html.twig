{% extends '@ForecastImport/_layout.html.twig' %}

{% block heading %}{{ 'forecast_import.title'|trans }}{% endblock %}

{% block content %}
    {% if not capabilities.plannerInstalled %}
        <div class="alert alert-danger">{{ 'forecast_import.planner_missing'|trans }}</div>
    {% endif %}

    <p class="text-secondary" style="max-width: 70ch">{{ 'forecast_import.intro'|trans }}</p>

    <div class="row row-cards">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title"><span class="badge bg-blue-lt me-2">1</span>{{ 'forecast_import.step_connect'|trans }}</h3>
                </div>
                {{ form_start(form) }}
                <div class="card-body">
                    {% if data %}
                        <div class="alert alert-info">
                            {{ 'forecast_import.last_fetch'|trans({
                                '%date%': data.fetchedAt|date_time,
                                '%begin%': data.begin|date_short,
                                '%end%': data.end|date_short,
                                '%count%': data.assignments|length
                            }) }}
                        </div>
                    {% endif %}
                    {{ form_widget(form) }}
                </div>
                <div class="card-footer text-end">
                    <button type="submit" class="btn btn-primary">{{ (data ? 'forecast_import.fetch_again' : 'forecast_import.fetch')|trans }}</button>
                </div>
                {{ form_end(form) }}
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card">
                <div class="list-group list-group-flush">
                    {% set steps = [
                        {'n': 2, 'route': 'forecast_import_people', 'title': 'forecast_import.step_people', 'done': summary ? summary.people_mapped : null, 'total': summary ? summary.people : null},
                        {'n': 3, 'route': 'forecast_import_projects', 'title': 'forecast_import.step_projects', 'done': summary ? summary.projects_mapped : null, 'total': summary ? summary.projects : null},
                        {'n': 4, 'route': 'forecast_import_tentative', 'title': 'forecast_import.step_tentative', 'done': summary ? summary.tentative_tags : null, 'total': null},
                        {'n': 5, 'route': 'forecast_import_preview', 'title': 'forecast_import.step_preview', 'done': null, 'total': null},
                    ] %}
                    {% for step in steps %}
                        {% if data %}
                            <a href="{{ path(step.route) }}" class="list-group-item list-group-item-action d-flex align-items-center gap-3">
                        {% else %}
                            <div class="list-group-item d-flex align-items-center gap-3 text-secondary">
                        {% endif %}
                            <span class="badge bg-blue-lt">{{ step.n }}</span>
                            <span class="flex-fill">{{ step.title|trans }}</span>
                            {% if step.total is not null %}
                                <span class="badge {{ step.done == step.total ? 'bg-green-lt' : 'bg-yellow-lt' }}">{{ 'forecast_import.mapped_of'|trans({'%done%': step.done, '%total%': step.total}) }}</span>
                            {% elseif step.done is not null %}
                                <span class="badge bg-secondary-lt">{{ 'forecast_import.tags_chosen'|trans({'%count%': step.done}) }}</span>
                            {% endif %}
                        {% if data %}</a>{% else %}</div>{% endif %}
                    {% endfor %}
                </div>
            </div>

            {% if imported > 0 %}
                <div class="card mt-3">
                    <div class="card-header"><h3 class="card-title">{{ 'forecast_import.start_over'|trans }}</h3></div>
                    <form method="post" action="{{ path('forecast_import_remove') }}">
                        <div class="card-body">
                            <p>{{ 'forecast_import.start_over_help'|trans({'%count%': imported}) }}</p>
                            <label class="form-check">
                                <input type="checkbox" class="form-check-input" name="confirm" value="1" id="forecast_import_remove_confirm" required>
                                <span class="form-check-label">{{ 'forecast_import.start_over_confirm'|trans({'%count%': imported}) }}</span>
                            </label>
                        </div>
                        <div class="card-footer text-end">
                            <input type="hidden" name="_token" value="{{ csrf_token('forecast_import_remove') }}">
                            <button type="submit" class="btn btn-outline-danger">{{ 'forecast_import.start_over_button'|trans }}</button>
                        </div>
                    </form>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
