                <source>forecast_import.automatic_help</source>
                <target>Found by the import, not saved. Change it to decide yourself.</target>
            </trans-unit>
            <trans-unit id="forecast_import.change">
                <source>forecast_import.change</source>
                <target>Change</target>
            </trans-unit>
            <trans-unit id="forecast_import.reset">
                <source>forecast_import.reset</source>
                <target>Undo my choice</target>
            </trans-unit>
            <trans-unit id="forecast_import.suggestion">
                <source>forecast_import.suggestion</source>
                <target>Suggestion</target>
            </trans-unit>
            <trans-unit id="forecast_import.score_help">
                <source>forecast_import.score_help</source>
                <target>How closely the names match</target>
            </trans-unit>
            <trans-unit id="forecast_import.accept_help">
                <source>forecast_import.accept_help</source>
                <target>Tick the suggestions you agree with and accept them together.</target>
            </trans-unit>
            <trans-unit id="forecast_import.accept_selected">
                <source>forecast_import.accept_selected</source>
                <target>Accept ticked suggestions</target>
            </trans-unit>
            <trans-unit id="forecast_import.accept_one">
                <source>forecast_import.accept_one</source>
                <target>Accept this suggestion</target>
            </trans-unit>
            <trans-unit id="forecast_import.action">
                <source>forecast_import.action</source>
                <target>Import as</target>
            </trans-unit>
            <trans-unit id="forecast_import.action_user">
                <source>forecast_import.action_user</source>
                <target>Planning for a Kimai user</target>
            </trans-unit>
            <trans-unit id="forecast_import.action_skip_person">
                <source>forecast_import.action_skip_person</source>
                <target>Do not import their planning</target>
            </trans-unit>
            <trans-unit id="forecast_import.action_work">
                <source>forecast_import.action_work</source>
                <target>Work for a customer</target>
            </trans-unit>
            <trans-unit id="forecast_import.action_time_off">
                <source>forecast_import.action_time_off</source>
                <target>Time off</target>
            </trans-unit>
            <trans-unit id="forecast_import.action_skip_project">
                <source>forecast_import.action_skip_project</source>
                <target>Do not import this project</target>
            </trans-unit>
            <trans-unit id="forecast_import.choose_user">
                <source>forecast_import.choose_user</source>
                <target>Choose a user.</target>
            </trans-unit>
            <trans-unit id="forecast_import.choose_customer">
                <source>forecast_import.choose_customer</source>
                <target>Choose a customer.</target>
            </trans-unit>
            <trans-unit id="forecast_import.project_of_other_customer">
                <source>forecast_import.project_of_other_customer</source>
                <target>This project belongs to another customer.</target>
            </trans-unit>
            <trans-unit id="forecast_import.tentative_tags">
                <source>forecast_import.tentative_tags</source>
                <target>Tags that mean tentative</target>
            </trans-unit>
            <trans-unit id="forecast_import.tentative_tags_help">
                <source>forecast_import.tentative_tags_help</source>
                <target>Forecast has no tentative flag. Assignments on projects with any of these tags are imported as tentative planning.</target>
            </trans-unit>
            <trans-unit id="forecast_import.tentative_unsupported">
                <source>forecast_import.tentative_unsupported</source>
                <target>The installed Weekly Planner has no tentative planning, so these assignments are imported as confirmed.</target>
            </trans-unit>
            <trans-unit id="forecast_import.no_tags">
                <source>forecast_import.no_tags</source>
                <target>None of the projects in this import have tags.</target>
            </trans-unit>
            <trans-unit id="forecast_import.save_and_preview">
                <source>forecast_import.save_and_preview</source>
                <target>Save and preview</target>
            </trans-unit>
            <trans-unit id="forecast_import.preview_intro">
                <source>forecast_import.preview_intro</source>
                <target>What importing %begin% to %end% would do right now. Nothing has been written yet.</target>
            </trans-unit>
            <trans-unit id="forecast_import.result_created">
                <source>forecast_import.result_created</source>
                <target>New</target>
            </trans-unit>
            <trans-unit id="forecast_import.result_updated">
                <source>forecast_import.result_updated</source>
                <target>Changed since last import</target>
            </trans-unit>
            <trans-unit id="forecast_import.result_unchanged">
                <source>forecast_import.result_unchanged</source>
