    <file source-language="en" target-language="en" datatype="plaintext" original="none">
        <body>
            <trans-unit id="forecast_import.title">
                <source>forecast_import.title</source>
                <target>Forecast import</target>
            </trans-unit>
            <trans-unit id="forecast_import.intro">
                <source>forecast_import.intro</source>
                <target>Bring your team's plan over from Harvest Forecast. Read Forecast once, decide where its people and projects go in Kimai, check the preview, then import. You can run it again at any time: unchanged plans stay as they are, changed ones are updated and nothing is created twice.</target>
            </trans-unit>
            <trans-unit id="forecast_import.planner_missing">
                <source>forecast_import.planner_missing</source>
                <target>The Weekly Planner (PlannerBundle) is not installed. Install it before importing.</target>
            </trans-unit>
            <trans-unit id="forecast_import.step_connect">
                <source>forecast_import.step_connect</source>
                <target>Read Forecast</target>
            </trans-unit>
            <trans-unit id="forecast_import.step_people">
                <source>forecast_import.step_people</source>
                <target>People</target>
            </trans-unit>
            <trans-unit id="forecast_import.step_projects">
                <source>forecast_import.step_projects</source>
                <target>Projects</target>
            </trans-unit>
            <trans-unit id="forecast_import.step_tentative">
                <source>forecast_import.step_tentative</source>
                <target>Tentative work</target>
            </trans-unit>
            <trans-unit id="forecast_import.step_preview">
                <source>forecast_import.step_preview</source>
                <target>Preview and import</target>
            </trans-unit>
            <trans-unit id="forecast_import.account_id">
                <source>forecast_import.account_id</source>
                <target>Forecast account ID</target>
            </trans-unit>
            <trans-unit id="forecast_import.account_id_help">
                <source>forecast_import.account_id_help</source>
                <target>The number in your Forecast address: forecastapp.com/&lt;account ID&gt;/.</target>
            </trans-unit>
            <trans-unit id="forecast_import.account_id_invalid">
                <source>forecast_import.account_id_invalid</source>
                <target>The account ID is a number.</target>
            </trans-unit>
            <trans-unit id="forecast_import.token">
                <source>forecast_import.token</source>
                <target>Harvest personal access token</target>
            </trans-unit>
            <trans-unit id="forecast_import.token_help">
                <source>forecast_import.token_help</source>
                <target>Create one at id.getharvest.com/developers. It is used to read Forecast this once and is never stored.</target>
            </trans-unit>
            <trans-unit id="forecast_import.begin">
                <source>forecast_import.begin</source>
                <target>Import from</target>
            </trans-unit>
            <trans-unit id="forecast_import.begin_help">
                <source>forecast_import.begin_help</source>
                <target>Planning before this date is not imported. Today is usually right.</target>
            </trans-unit>
            <trans-unit id="forecast_import.end">
                <source>forecast_import.end</source>
                <target>Import until</target>
            </trans-unit>
            <trans-unit id="forecast_import.fetch">
                <source>forecast_import.fetch</source>
                <target>Read Forecast</target>
            </trans-unit>
            <trans-unit id="forecast_import.fetch_again">
                <source>forecast_import.fetch_again</source>
                <target>Read Forecast again</target>
            </trans-unit>
            <trans-unit id="forecast_import.last_fetch">
                <source>forecast_import.last_fetch</source>
                <target>Read %date%: %count% assignments between %begin% and %end%.</target>
            </trans-unit>
            <trans-unit id="forecast_import.mapped_of">
                <source>forecast_import.mapped_of</source>
                <target>%done% of %total% mapped</target>
            </trans-unit>
            <trans-unit id="forecast_import.tags_chosen">
                <source>forecast_import.tags_chosen</source>
                <target>%count% tags</target>
            </trans-unit>
            <trans-unit id="forecast_import.start_over">
                <source>forecast_import.start_over</source>
                <target>Start over</target>
            </trans-unit>
            <trans-unit id="forecast_import.start_over_help">
                <source>forecast_import.start_over_help</source>
                <target>Removes the %count% plannings this import created. Plannings made in Kimai and your mapping decisions are kept.</target>
            </trans-unit>
            <trans-unit id="forecast_import.start_over_confirm">
                <source>forecast_import.start_over_confirm</source>
                <target>Yes, remove all %count% imported plannings</target>
            </trans-unit>
            <trans-unit id="forecast_import.start_over_button">
                <source>forecast_import.start_over_button</source>
                <target>Remove imported plannings</target>
            </trans-unit>
            <trans-unit id="forecast_import.people_intro">
                <source>forecast_import.people_intro</source>
                <target>People are matched to Kimai users by email address. Placeholders are skipped, because the planner plans people only, but you can give one to a user.</target>
            </trans-unit>
            <trans-unit id="forecast_import.projects_intro">
                <source>forecast_import.projects_intro</source>
                <target>Choose the Kimai customer, and optionally project, for each Forecast project. Suggestions compare customer and project names; strong ones are ticked already. Forecast's "Time Off" project becomes time off.</target>
            </trans-unit>
            <trans-unit id="forecast_import.next_projects">
                <source>forecast_import.next_projects</source>
                <target>Next: projects</target>
            </trans-unit>
            <trans-unit id="forecast_import.next_tentative">
                <source>forecast_import.next_tentative</source>
                <target>Next: tentative work</target>
            </trans-unit>
            <trans-unit id="forecast_import.forecast">
                <source>forecast_import.forecast</source>
                <target>Forecast</target>
            </trans-unit>
            <trans-unit id="forecast_import.kimai">
                <source>forecast_import.kimai</source>
                <target>Kimai</target>
            </trans-unit>
            <trans-unit id="forecast_import.assignments">
                <source>forecast_import.assignments</source>
                <target>Assignments</target>
            </trans-unit>
            <trans-unit id="forecast_import.assignments_count">
                <source>forecast_import.assignments_count</source>
                <target>%count% assignments</target>
            </trans-unit>
            <trans-unit id="forecast_import.placeholder">
                <source>forecast_import.placeholder</source>
                <target>Placeholder</target>
            </trans-unit>
            <trans-unit id="forecast_import.archived">
                <source>forecast_import.archived</source>
                <target>Archived in Forecast</target>
            </trans-unit>
            <trans-unit id="forecast_import.disabled">
                <source>forecast_import.disabled</source>
                <target>Inactive</target>
            </trans-unit>
            <trans-unit id="forecast_import.unmapped">
                <source>forecast_import.unmapped</source>
                <target>Not mapped</target>
            </trans-unit>
            <trans-unit id="forecast_import.time_off">
                <source>forecast_import.time_off</source>
                <target>Time off</target>
            </trans-unit>
            <trans-unit id="forecast_import.skipped">
                <source>forecast_import.skipped</source>
                <target>Skipped</target>
            </trans-unit>
            <trans-unit id="forecast_import.automatic">
                <source>forecast_import.automatic</source>
                <target>Automatic</target>
            </trans-unit>
