                <source>forecast_import.problems</source>
                <target>Worth checking</target>
            </trans-unit>
            <trans-unit id="forecast_import.left_out">
                <source>forecast_import.left_out</source>
                <target>Left out</target>
            </trans-unit>
            <trans-unit id="forecast_import.note">
                <source>forecast_import.note</source>
                <target>Note</target>
            </trans-unit>
            <trans-unit id="forecast_import.problem.person_unmapped">
                <source>forecast_import.problem.person_unmapped</source>
                <target>People without a Kimai user</target>
            </trans-unit>
            <trans-unit id="forecast_import.problem.placeholder_unmapped">
                <source>forecast_import.problem.placeholder_unmapped</source>
                <target>Placeholders without a Kimai user</target>
            </trans-unit>
            <trans-unit id="forecast_import.problem.project_unmapped">
                <source>forecast_import.problem.project_unmapped</source>
                <target>Projects without a Kimai customer</target>
            </trans-unit>
            <trans-unit id="forecast_import.problem.user_disabled">
                <source>forecast_import.problem.user_disabled</source>
                <target>Planned for inactive Kimai users</target>
            </trans-unit>
            <trans-unit id="forecast_import.problem.time_off_unsupported">
                <source>forecast_import.problem.time_off_unsupported</source>
