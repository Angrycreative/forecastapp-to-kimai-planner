            </trans-unit>
            <trans-unit id="forecast_import.problem.tentative_unsupported">
                <source>forecast_import.problem.tentative_unsupported</source>
                <target>Tentative work, imported as confirmed</target>
            </trans-unit>
            <trans-unit id="forecast_import.run_help">
                <source>forecast_import.run_help</source>
                <target>Assignments that are left out keep whatever an earlier import created. Run the import again whenever Forecast changes.</target>
            </trans-unit>
            <trans-unit id="forecast_import.back_to_projects">
                <source>forecast_import.back_to_projects</source>
                <target>Back to projects</target>
            </trans-unit>
